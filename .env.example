# Public browser/server configuration. Use only the verified CORO CUMBRES project.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy anon keys are accepted only if a publishable key is unavailable.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Bootstrap only: load into the migration command's process, never NEXT_PUBLIC_*.
# Not needed by the application, OAuth callback or administrative UI.
# SUPABASE_SERVICE_ROLE_KEY=

# Existing V2 editorial Gospel overrides only; server-side private Blob.
# BLOB_READ_WRITE_TOKEN=
# BLOB_STORE_ID=
